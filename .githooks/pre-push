#!/bin/sh
# 推送前完整质量门（由 tools/install_hooks.py 通过 core.hooksPath=.githooks 启用）。
# Git 在仓库根目录执行本钩子，因此可直接使用相对路径。
# 在快速门（见 .githooks/pre-commit）基础上额外运行全量测试。

PYTHON="${PYTHON:-python}"

fail() {
    echo ""
    echo "质量门未通过，推送被阻止。"
    echo "如确需跳过用 git push --no-verify（不推荐）。"
    exit 1
}

echo "[pre-push] audit_broad_except ..."
"$PYTHON" tools/audit_broad_except.py || fail

echo "[pre-push] audit_risky_calls ..."
"$PYTHON" tools/audit_risky_calls.py || fail

echo "[pre-push] module_hotspot_report (baseline regression) ..."
"$PYTHON" tools/module_hotspot_report.py --top 0 --baseline quality/module_hotspot_baseline.json --fail-on-regression --max-lines 1000 --fail-on-threshold || fail

echo "[pre-push] compileall ..."
"$PYTHON" -m compileall -q src tests _import_and_run.py || fail

echo "[pre-push] pytest ..."
"$PYTHON" -m pytest -q || fail

exit 0
